server_tokens off;

client_max_body_size 26m;
client_header_buffer_size 2k;
large_client_header_buffers 4 8k;
client_header_timeout 10s;
client_body_timeout 30s;
send_timeout 30s;
reset_timedout_connection on;

limit_conn_zone $binary_remote_addr zone=download_per_ip:10m;
limit_conn_zone $server_name zone=backend_total:10m;
limit_conn_status 429;

proxy_connect_timeout 5s;
proxy_send_timeout 30s;
proxy_read_timeout 60s;
proxy_request_buffering on;
proxy_buffering on;
proxy_buffer_size 16k;
proxy_buffers 8 16k;
proxy_busy_buffers_size 32k;
proxy_max_temp_file_size 32m;
proxy_temp_file_write_size 64k;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream messaging_backend {
    server backend:8000;
    keepalive 16;
}

upstream messaging_frontend {
    server frontend:3000;
    keepalive 8;
}

server {
    listen 8080 default_server;
    server_name "";
    return 444;
}

server {
    listen 8443 ssl default_server;
    server_name "";
    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    return 444;
}

server {
    listen 8080;
    server_name ${PUBLIC_HOST};
    return 308 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    server_name ${PUBLIC_HOST};

    ssl_certificate /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    limit_conn download_per_ip 20;
    limit_conn backend_total 200;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss:; worker-src 'self' blob:; upgrade-insecure-requests" always;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";

    location = /ready { return 404; }
    location = /v1/ready { return 404; }
    location = /docs { return 404; }
    location = /redoc { return 404; }
    location = /openapi.json { return 404; }

    location = /v1/ws {
        proxy_pass http://messaging_backend;
        proxy_http_version 1.1;
        # Nginx does not inherit server-level proxy_set_header directives when
        # a location defines any of its own, so repeat the trusted identity
        # headers before the WebSocket-specific values.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 35m;
    }

    location /v1/ {
        proxy_pass http://messaging_backend;
        proxy_http_version 1.1;
    }

    location = /health {
        proxy_pass http://messaging_backend;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass http://messaging_frontend;
        proxy_http_version 1.1;
    }
}

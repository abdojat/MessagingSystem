# Use with: docker compose --env-file .env.production -f docker-compose.production.yml up --build
ENVIRONMENT=production

# Use URL-safe random values for credentials embedded in service URLs:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_DB=channels
POSTGRES_ADMIN_USER=messaging_admin
POSTGRES_ADMIN_PASSWORD=replace_with_urlsafe_random_value
POSTGRES_APP_USER=messaging_app
POSTGRES_APP_PASSWORD=replace_with_urlsafe_random_value
RABBITMQ_USER=messaging_broker
RABBITMQ_PASSWORD=replace_with_urlsafe_random_value
REDIS_PASSWORD=replace_with_urlsafe_random_value
JWT_SECRET=replace_with_urlsafe_random_value

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEY=replace_with_fernet_key

PUBLIC_HOST=chat.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Supply these files externally. Never store the private key in the repository.
TLS_CERT_PATH=/absolute/operator/path/tls.crt
TLS_KEY_PATH=/absolute/operator/path/tls.key

# Optional explicit one-shot bootstrap values. Keep empty during normal startup.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Use with: docker compose --env-file .env.production -f docker-compose.production.yml up --build
ENVIRONMENT=production

# Use URL-safe random values for credentials embedded in service URLs:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_DB=channels
POSTGRES_ADMIN_USER=messaging_admin
POSTGRES_ADMIN_PASSWORD=replace_with_urlsafe_random_value
POSTGRES_APP_USER=messaging_app
POSTGRES_APP_PASSWORD=replace_with_urlsafe_random_value
RABBITMQ_USER=messaging_broker
RABBITMQ_PASSWORD=replace_with_urlsafe_random_value
REDIS_PASSWORD=replace_with_urlsafe_random_value
JWT_SECRET=replace_with_urlsafe_random_value

# Generic provider-independent SMTP. Credentials are injected only into the
# backend container. Use either implicit TLS or STARTTLS, never plaintext.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_TTL_MINUTES=30
EMAIL_VERIFICATION_PUBLIC_URL=https://chat.example.com/en/verify-email
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM_EMAIL=no-reply@chat.example.com
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=true

PRESENCE_LEASE_SECONDS=60
PRESENCE_REFRESH_SECONDS=20
PRESENCE_REAPER_INTERVAL_SECONDS=10
PRESENCE_REAPER_BATCH_SIZE=200

# Generate once with: python -m app.db.merkle_tool generate-keypair --key-id audit-2026-01
# Keep historical public keys for rotation. The private seed is injected only
# into the optional merkle-checkpoint service, never backend/worker/frontend/proxy.
AUDIT_MERKLE_VERIFICATION_ENABLED=true
AUDIT_MERKLE_BATCH_SIZE=256
AUDIT_MERKLE_PUBLIC_KEYS={"audit-2026-01":"replace_with_base64_ed25519_public_key"}
AUDIT_MERKLE_SIGNING_KEY_ID=audit-2026-01
AUDIT_MERKLE_SIGNING_PRIVATE_KEY=replace_with_base64_ed25519_private_seed

# Generate each master key with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DATA_ENCRYPTION_ACTIVE_KEY_ID=key-2026-08
DATA_ENCRYPTION_KEYS={"key-2026-08":"replace_with_base64_32_byte_master_key"}
ALLOW_LEGACY_PLAINTEXT_MESSAGES=false
ALLOW_LEGACY_PLAINTEXT_UPLOADS=false

# Optional deprecated legacy-v1 Fernet key. Keep it only during historical
# message migration; new writes never use it.
MESSAGE_ENCRYPTION_KEY=

PUBLIC_HOST=chat.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Supply these files externally. Never store the private key in the repository.
TLS_CERT_PATH=/absolute/operator/path/tls.crt
TLS_KEY_PATH=/absolute/operator/path/tls.key

# Optional explicit one-shot bootstrap values. Keep empty during normal startup.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

#   cd backend
#   python -m app.db.merkle_tool generate-keypair --key-id audit-demo

AUDIT_MERKLE_SIGNING_KEY_ID=audit-demo
AUDIT_MERKLE_SIGNING_PRIVATE_KEY=replace_with_base64_ed25519_private_seed

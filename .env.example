APP_NAME=channels-backend
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/channels
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
# Development-only placeholder. production/prod/staging reject this value.
# Generate a deployment value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-jwt-secret
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
# Sliding refresh inactivity limit is capped by this non-sliding lifetime.
SESSION_ABSOLUTE_TTL_DAYS=30
# Opaque WebSocket tickets are single-use and stored as hashes in Redis.
WS_TICKET_TTL_SECONDS=30
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_INITIAL_RETRY_DELAY_SECONDS=5
OUTBOX_RETRY_BACKOFF_MULTIPLIER=2
OUTBOX_MAX_RETRY_DELAY_SECONDS=300
WORKER_ONLINE_SCAN_INTERVAL=3.0
# Total rows returned by one WebSocket subscribe/resume history command.
WS_HISTORY_BATCH_LIMIT=100
# Docker Uvicorn and the application both enforce this inbound WS message cap.
WS_MAX_INBOUND_MESSAGE_BYTES=16384
# Per-socket weighted command bucket (subscribe/resume cost 10; seen and
# unsubscribe cost 3; ping/auth/sync cost 1).
WS_COMMAND_BUDGET_CAPACITY=60
WS_COMMAND_BUDGET_REFILL_PER_SECOND=1.0
# Per-socket history-row reservation bucket. One command is also capped by
# WS_HISTORY_BATCH_LIMIT; repeated history work is rejected when depleted.
WS_HISTORY_BUDGET_CAPACITY=300
WS_HISTORY_BUDGET_REFILL_PER_SECOND=5.0
# Grouped abuse limits. Sensitive groups fall back to a bounded per-process
# limiter when Redis is unavailable; saturation denies new sensitive keys
# without evicting existing state. Ordinary paginated reads are not blocked.
RATE_LIMIT_AUTH_IP_PER_MINUTE=30
RATE_LIMIT_AUTH_IDENTITY_PER_MINUTE=20
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_MESSAGE_WRITE_PER_10_SECONDS=200
RATE_LIMIT_MESSAGE_WRITE_BURST_PER_SECOND=40
RATE_LIMIT_MEDIA_PER_MINUTE=60
RATE_LIMIT_CHANNEL_MANAGEMENT_PER_MINUTE=30
RATE_LIMIT_WEBSOCKET_PER_MINUTE=30
RATE_LIMIT_SYNC_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_LOCAL_MAX_KEYS=10000
# Logical message limits are checked before encryption/outbox/broker work.
MESSAGE_TEXT_MAX_BYTES=65536
MESSAGE_JSON_MAX_BYTES=65536
MESSAGE_JSON_MAX_DEPTH=20
MAX_DISTINCT_REACTIONS_PER_MESSAGE=20
# Cheap account-level resource quotas.
MAX_CHANNELS_OWNED_PER_USER=50
MAX_ACTIVE_INVITES_PER_USER=100
MAX_UPLOADS_PER_USER_PER_DAY=100
MAX_PENDING_UPLOADS_PER_USER=10
MAX_STORED_UPLOAD_BYTES_PER_USER=1073741824
MAX_WEBSOCKET_CONNECTIONS_PER_USER=5
# Atomic per-backend protected-download admission. The recommended proxy path
# adds its own connection/time/body/header bounds.
MAX_CONCURRENT_DOWNLOADS_PER_USER=3
MAX_CONCURRENT_DOWNLOADS_PER_IP=12
MAX_CONCURRENT_DOWNLOADS_GLOBAL=100
# Direct development ignores forwarding headers. docker-compose.hardened.yml
# supplies its proxy's fixed private /32; customize this only with explicit
# trusted-proxy networking.
TRUSTED_PROXY_CIDRS=[]
# Matching realtime generations use this short authorization-cache window.
WS_MEMBERSHIP_AUTH_CACHE_TTL_SECONDS=1.0
# RabbitMQ is a bounded realtime buffer; PostgreSQL + REST sync are durable.
RABBIT_USER_QUEUE_EXPIRES_MS=604800000
RABBIT_USER_QUEUE_MESSAGE_TTL_MS=86400000
RABBIT_USER_QUEUE_MAX_LENGTH=10000
# Redis fanout attempts are paced before RabbitMQ requeue.
REDIS_FANOUT_MAX_ATTEMPTS=3
REDIS_FANOUT_INITIAL_RETRY_DELAY_SECONDS=0.5
REDIS_FANOUT_MAX_RETRY_DELAY_SECONDS=5.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Keep the existing frontend media limit at 25 MiB unless intentionally changed.
UPLOAD_MAX_SIZE_BYTES=26214400
UPLOADS_BASE_DIR=/data/uploads
API_V1_PREFIX=/v1
MESSAGE_ENCRYPTION_ENABLED=true
# Required in production/prod/staging when encryption is enabled.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEY=
# Optional one-time bootstrap. Use a unique 12+ character password; existing normal users are never auto-promoted.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

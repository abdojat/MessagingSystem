# =============================================================================
# MessagingSystem - Development Environment Configuration
# =============================================================================
#
# This file is a SAFE TEMPLATE for local development.
#
# Recommended usage:
#
#   PowerShell:
#   Copy-Item .env.example .env
#
#   CMD:
#   copy .env.example .env
#
# Put real passwords, encryption keys, SMTP credentials, etc. in `.env`,
# NOT in `.env.example`.
#
# Never commit your real `.env` file.
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

APP_NAME=channels-backend

# Explicit development environment.
# Supported development-like values include:
# dev, development, local, test
#
# Other values are treated as production-like and enable stricter validation.
ENVIRONMENT=dev


# =============================================================================
# CORE INFRASTRUCTURE
# =============================================================================

# PostgreSQL database used by the backend.
# These credentials match the local docker-compose.yml PostgreSQL service.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/channels

# RabbitMQ broker used for realtime/event delivery.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis used for rate limiting, presence, WebSocket state, and other
# short-lived/distributed state.
REDIS_URL=redis://redis:6379/0


# =============================================================================
# AUTHENTICATION & JWT
# =============================================================================

# Development placeholder only.
#
# For your real .env, generate a random secret with:
#
# python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Never use this placeholder in production.
JWT_SECRET=change-this-jwt-secret

# Access-token lifetime in minutes.
JWT_ACCESS_TTL_MIN=30

# Refresh-token lifetime in days.
JWT_REFRESH_TTL_DAYS=14

# Maximum absolute session lifetime.
# Refreshing a session cannot extend it beyond this limit.
SESSION_ABSOLUTE_TTL_DAYS=30


# =============================================================================
# WEBSOCKET AUTHENTICATION
# =============================================================================

# Single-use opaque WebSocket authentication ticket lifetime.
WS_TICKET_TTL_SECONDS=30


# =============================================================================
# OUTBOX / BACKGROUND WORKER
# =============================================================================

# How often the worker checks for pending outbox events.
OUTBOX_POLL_INTERVAL=1.0

# Maximum delivery attempts before an outbox item is considered exhausted.
OUTBOX_MAX_ATTEMPTS=5

# Initial retry delay after a failed delivery.
OUTBOX_INITIAL_RETRY_DELAY_SECONDS=5

# Multiplier applied between retries.
OUTBOX_RETRY_BACKOFF_MULTIPLIER=2

# Maximum retry delay.
OUTBOX_MAX_RETRY_DELAY_SECONDS=300

# How often the worker checks online-user state.
WORKER_ONLINE_SCAN_INTERVAL=3.0


# =============================================================================
# WEBSOCKET HISTORY & MESSAGE LIMITS
# =============================================================================

# Maximum number of historical rows returned by one subscribe/resume request.
WS_HISTORY_BATCH_LIMIT=100

# Maximum size of one inbound WebSocket message.
# 16384 bytes = 16 KiB.
WS_MAX_INBOUND_MESSAGE_BYTES=16384


# =============================================================================
# WEBSOCKET COMMAND BUDGET
# =============================================================================
#
# Commands consume different amounts of this budget.
# Expensive commands such as subscribe/resume cost more than simple ping/auth.
# =============================================================================

WS_COMMAND_BUDGET_CAPACITY=60
WS_COMMAND_BUDGET_REFILL_PER_SECOND=1.0


# =============================================================================
# WEBSOCKET HISTORY BUDGET
# =============================================================================
#
# Prevents a client from continuously requesting expensive message history.
# =============================================================================

WS_HISTORY_BUDGET_CAPACITY=300
WS_HISTORY_BUDGET_REFILL_PER_SECOND=5.0


# =============================================================================
# RATE LIMITING
# =============================================================================

# Authentication attempts originating from one IP.
RATE_LIMIT_AUTH_IP_PER_MINUTE=30

# Authentication attempts targeting one identity/account.
RATE_LIMIT_AUTH_IDENTITY_PER_MINUTE=20

# Search requests.
RATE_LIMIT_SEARCH_PER_MINUTE=60

# Message writes over a 10-second period.
RATE_LIMIT_MESSAGE_WRITE_PER_10_SECONDS=200

# Short message-write burst limit.
RATE_LIMIT_MESSAGE_WRITE_BURST_PER_SECOND=40

# Upload creation and body-write requests.
RATE_LIMIT_MEDIA_PER_MINUTE=60

# Authorized upload reads/downloads. Kept separate so media-heavy views do not
# consume the stricter upload-write budget.
RATE_LIMIT_UPLOAD_READ_PER_MINUTE=600

# Channel management operations.
RATE_LIMIT_CHANNEL_MANAGEMENT_PER_MINUTE=30

# New WebSocket connection attempts.
RATE_LIMIT_WEBSOCKET_PER_MINUTE=30

# Synchronization operations.
RATE_LIMIT_SYNC_PER_MINUTE=60

# Administrative operations.
RATE_LIMIT_ADMIN_PER_MINUTE=60


# =============================================================================
# EMAIL VERIFICATION RATE LIMITING
# =============================================================================

# Verification emails one user can request per 15 minutes.
RATE_LIMIT_EMAIL_VERIFICATION_USER_PER_15_MINUTES=5

# Verification email requests from one IP per 15 minutes.
RATE_LIMIT_EMAIL_VERIFICATION_IP_PER_15_MINUTES=10

# Verification confirmation attempts per 15 minutes.
RATE_LIMIT_EMAIL_VERIFICATION_CONFIRM_PER_15_MINUTES=20


# =============================================================================
# LOCAL RATE-LIMITER FALLBACK
# =============================================================================
#
# Sensitive operations have a bounded local fallback if Redis becomes
# unavailable. This limits how many unique keys may be stored locally.
# =============================================================================

RATE_LIMIT_LOCAL_MAX_KEYS=10000


# =============================================================================
# MESSAGE LIMITS
# =============================================================================

# Maximum UTF-8 text message size.
# 65536 bytes = 64 KiB.
MESSAGE_TEXT_MAX_BYTES=65536

# Maximum JSON message size.
MESSAGE_JSON_MAX_BYTES=65536

# Maximum allowed nested JSON depth.
MESSAGE_JSON_MAX_DEPTH=20

# Maximum number of distinct reaction types on one message.
MAX_DISTINCT_REACTIONS_PER_MESSAGE=20


# =============================================================================
# ACCOUNT RESOURCE QUOTAS
# =============================================================================

# Maximum channels one user may own.
MAX_CHANNELS_OWNED_PER_USER=50

# Maximum active invitations created by one user.
MAX_ACTIVE_INVITES_PER_USER=100

# Maximum uploads per user per day.
MAX_UPLOADS_PER_USER_PER_DAY=100

# Maximum unfinished/pending uploads per user.
MAX_PENDING_UPLOADS_PER_USER=10

# Maximum total stored upload data per user.
# 1073741824 bytes = 1 GiB.
MAX_STORED_UPLOAD_BYTES_PER_USER=1073741824

# Maximum simultaneous WebSocket connections per user.
MAX_WEBSOCKET_CONNECTIONS_PER_USER=5


# =============================================================================
# PROTECTED DOWNLOAD LIMITS
# =============================================================================

# Higher read capacity for attachment-heavy channels. These remain bounded per
# backend process; lower them for small deployments or untrusted public traffic.
MAX_CONCURRENT_DOWNLOADS_PER_USER=20
MAX_CONCURRENT_DOWNLOADS_PER_IP=100
MAX_CONCURRENT_DOWNLOADS_GLOBAL=1000


# =============================================================================
# TRUSTED PROXIES
# =============================================================================
#
# Keep empty for normal local development.
#
# The hardened deployment configuration supplies the private proxy network.
# Only add networks that really belong to trusted reverse proxies.
# =============================================================================

TRUSTED_PROXY_CIDRS=[]


# =============================================================================
# REALTIME AUTHORIZATION CACHE
# =============================================================================

# Very short membership-authorization cache used for realtime events.
WS_MEMBERSHIP_AUTH_CACHE_TTL_SECONDS=1.0


# =============================================================================
# PRESENCE / ONLINE STATUS
# =============================================================================

# Duration of one online-presence lease.
PRESENCE_LEASE_SECONDS=60

# How often an active connection refreshes its presence lease.
# Must be lower than PRESENCE_LEASE_SECONDS.
PRESENCE_REFRESH_SECONDS=20

# How often expired presence entries are cleaned.
PRESENCE_REAPER_INTERVAL_SECONDS=10

# Maximum entries processed during one cleanup batch.
PRESENCE_REAPER_BATCH_SIZE=200


# =============================================================================
# RABBITMQ USER QUEUES
# =============================================================================

# Expire unused user queues after 7 days.
RABBIT_USER_QUEUE_EXPIRES_MS=604800000

# Messages remaining in RabbitMQ expire after 24 hours.
# PostgreSQL remains the durable source of truth.
RABBIT_USER_QUEUE_MESSAGE_TTL_MS=86400000

# Maximum queued messages per user queue.
RABBIT_USER_QUEUE_MAX_LENGTH=10000


# =============================================================================
# REDIS FANOUT RETRIES
# =============================================================================

REDIS_FANOUT_MAX_ATTEMPTS=3
REDIS_FANOUT_INITIAL_RETRY_DELAY_SECONDS=0.5
REDIS_FANOUT_MAX_RETRY_DELAY_SECONDS=5.0


# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO


# =============================================================================
# CORS
# =============================================================================
#
# Local frontend origins allowed to make credentialed requests.
# Never use "*" with credentialed production CORS.
# =============================================================================

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]


# =============================================================================
# AUTHENTICATION COOKIES
# =============================================================================

# Local development uses HTTP, therefore Secure cookies are disabled.
#
# Production-like environments require secure cookies.
AUTH_COOKIE_SECURE=false

# Prevent browser cookies from being sent in most cross-site contexts.
AUTH_COOKIE_SAMESITE=strict


# =============================================================================
# TRUSTED HTTP HOSTS
# =============================================================================

TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]


# =============================================================================
# API DOCUMENTATION
# =============================================================================

# Enables FastAPI interactive API documentation in development.
# Production normally disables this.
ENABLE_API_DOCS=true


# =============================================================================
# FILE UPLOADS
# =============================================================================

# Maximum uploaded file size.
# 26214400 bytes = 25 MiB.
UPLOAD_MAX_SIZE_BYTES=26214400

# Maximum size for ordinary API request bodies.
# Streamed file uploads are controlled separately by UPLOAD_MAX_SIZE_BYTES.
API_REQUEST_BODY_MAX_BYTES=131072

# Internal Docker storage location for uploaded files.
UPLOADS_BASE_DIR=/data/uploads


# =============================================================================
# API ROUTING
# =============================================================================

API_V1_PREFIX=/v1


# =============================================================================
# EMAIL VERIFICATION
# =============================================================================

# Enable the email-verification feature.
EMAIL_VERIFICATION_ENABLED=true

# Verification token lifetime in minutes.
EMAIL_VERIFICATION_TTL_MINUTES=30

# Frontend page that handles verification links.
EMAIL_VERIFICATION_PUBLIC_URL=http://localhost:3000/en/verify-email


# =============================================================================
# EMAIL DELIVERY
# =============================================================================
#
# Development options:
#
#   console
#       Prints the generated verification URL in backend logs.
#       Recommended for simple local development.
#
#   capture
#       Intended mainly for tests.
#
#   smtp
#       Sends real email through an SMTP provider.
#
# Production requires SMTP when email verification is enabled.
# =============================================================================

EMAIL_DELIVERY_MODE=console


# =============================================================================
# SMTP
# =============================================================================
#
# These values are intentionally empty while EMAIL_DELIVERY_MODE=console.
#
# Fill them only when switching to:
#
# EMAIL_DELIVERY_MODE=smtp
#
# Example:
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=account@example.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_USE_TLS=false
# SMTP_USE_STARTTLS=true
#
# Never place a real SMTP password in .env.example.
# =============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Implicit TLS, commonly used with SMTP port 465.
SMTP_USE_TLS=false

# STARTTLS, commonly used with SMTP port 587.
SMTP_USE_STARTTLS=true


# =============================================================================
# AUDIT MERKLE VERIFICATION
# =============================================================================
#
# Used for cryptographically signed audit-log checkpoints.
#
# Development can leave verification disabled.
# =============================================================================

AUDIT_MERKLE_VERIFICATION_ENABLED=false

# Number of audit records processed per Merkle batch.
AUDIT_MERKLE_BATCH_SIZE=256

# Enable the isolated automatic checkpoint process. It runs once on startup,
# then checks again after each configured interval.
AUDIT_MERKLE_CHECKPOINT_ENABLED=true

# How often the automatic Merkle checkpoint service checks for pending audit
# events. 300 seconds = 5 minutes; 60 seconds = 1 minute. Minimum: 10 seconds.
AUDIT_MERKLE_CHECKPOINT_INTERVAL_SECONDS=300

# Trusted Ed25519 public-key ring.
#
# Production example:
#
# AUDIT_MERKLE_PUBLIC_KEYS={"audit-2026-01":"BASE64_PUBLIC_KEY"}
#
AUDIT_MERKLE_PUBLIC_KEYS={}


# =============================================================================
# AUDIT MERKLE SIGNING
# =============================================================================
#
# Signing credentials should ONLY be supplied to an explicit checkpoint
# command/container. For development Compose, copy
# .env.merkle-checkpointer.example to .env.merkle-checkpointer and put the
# active key ID/private seed there.
#
# Do not place a real private signing seed in the normal application .env.
#
# Generate a keypair with:
#
# python -m app.db.merkle_tool generate-keypair
#
# Example placeholders:
#
# AUDIT_MERKLE_SIGNING_KEY_ID=audit-demo
# AUDIT_MERKLE_SIGNING_PRIVATE_KEY=replace_with_base64_ed25519_private_seed
# =============================================================================


# =============================================================================
# DATA ENCRYPTION
# =============================================================================
#
# New messages/uploads use a versioned encryption-key ring.
#
# For local development, both variables may remain empty. The backend then
# uses its deterministic DEVELOPMENT-ONLY fallback key.
#
# For a more realistic local configuration, generate a key with:
#
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
#
# Then configure:
#
# DATA_ENCRYPTION_ACTIVE_KEY_ID=key-dev-01
# DATA_ENCRYPTION_KEYS={"key-dev-01":"GENERATED_KEY"}
#
# Production MUST use real random keys.
# =============================================================================

DATA_ENCRYPTION_ACTIVE_KEY_ID=
DATA_ENCRYPTION_KEYS=


# =============================================================================
# LEGACY PLAINTEXT MIGRATION
# =============================================================================
#
# Development migration switches for old plaintext database/file records.
#
# Production-like environments reject these when set to true.
# =============================================================================

ALLOW_LEGACY_PLAINTEXT_MESSAGES=true
ALLOW_LEGACY_PLAINTEXT_UPLOADS=true


# =============================================================================
# LEGACY MESSAGE ENCRYPTION
# =============================================================================
#
# Deprecated.
#
# Used only to decrypt/migrate historical v1 encrypted messages.
# New writes DO NOT use this key.
#
# Leave empty unless you specifically have old v1 encrypted data to migrate.
# =============================================================================

MESSAGE_ENCRYPTION_KEY=


# =============================================================================
# OPTIONAL SUPERADMIN BOOTSTRAP
# =============================================================================
#
# Leave all values empty if you do not want automatic superadmin creation.
#
# If enabled:
#   - SUPERADMIN_USERNAME and SUPERADMIN_PASSWORD must both be provided.
#   - SUPERADMIN_EMAIL is optional.
#   - Use a unique strong password of at least 12 characters.
#
# Example for your PRIVATE .env:
#
# SUPERADMIN_USERNAME=admin
# SUPERADMIN_EMAIL=admin@example.com
# SUPERADMIN_PASSWORD=your_private_strong_password
#
# Never put a real password in .env.example.
# =============================================================================

SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=


# =============================================================================
# FRONTEND
# =============================================================================

# Public URL used by the browser frontend to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
